# Copy this file to .env and set values for your environment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Use one PostgreSQL connection method: DATABASE_URL or the DB_* fields below.
# For hosted PostgreSQL, add ?sslmode=require to the URL when required by the provider.
DATABASE_URL=

# Leave DB_NAME empty to use SQLite when DATABASE_URL is also empty.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=
