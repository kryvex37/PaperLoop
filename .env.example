# Copy this file to .env and set values for your environment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Copy this file to .env, then set a private secret and PostgreSQL credentials.
# This template is safe to commit; never commit the populated .env file.
# For hosted PostgreSQL, add ?sslmode=require to DATABASE_URL if required.
DATABASE_URL=

# PostgreSQL connection used when DATABASE_URL is empty.
DB_NAME=paperloop
DB_USER=postgres
DB_PASSWORD=replace-this-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=
